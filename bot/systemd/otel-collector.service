[Unit]
Description=OpenTelemetry Collector (prod)
After=network.target

[Service]
Type=simple
User=mbabaev
WorkingDirectory=/home/mbabaev/MetaTheGathering/meta_the_gathering
EnvironmentFile=/home/mbabaev/MetaTheGathering/meta_the_gathering/bot/.env
ExecStart=/usr/local/bin/otelcol --config /home/mbabaev/MetaTheGathering/meta_the_gathering/otel-collector.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
