[Unit]
Description=Pauper Duel Simulator (side web project)
After=network.target

[Service]
Type=simple
User=mbabaev
WorkingDirectory=/home/mbabaev/MetaTheGathering/pauper_sim
Environment="PATH=/home/mbabaev/MetaTheGathering/pauper_sim/venv/bin"
Environment="PYTHONPATH=/home/mbabaev/MetaTheGathering/pauper_sim"
ExecStart=/home/mbabaev/MetaTheGathering/pauper_sim/venv/bin/uvicorn pauper_sim.app:app --host 0.0.0.0 --port 8083
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target