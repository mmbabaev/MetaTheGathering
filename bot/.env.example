# Telegram bot token
BOT_TOKEN=your-telegram-bot-token

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Monium / OpenTelemetry
MONIUM_PROJECT=folder__xxxxxxxxxxxxxxxxxx
MONIUM_API_KEY=your-monium-api-key
OTEL_SERVICE_NAME=meta-the-gathering
# PostgreSQL
DATABASE_URL=postgresql://mbabaev:password@localhost:5432/meta_the_gathering_prod

# YandexGPT — опциональный фолбэк для определения цвета архетипа по названию.
# Пусто = выключен: цвет берётся из словаря/эвристики, иначе колода считается бесцветной.
YANDEX_API_KEY=your-yandex-api-key
YANDEX_FOLDER_ID=your-yandex-folder-id
YANDEX_MODEL=yandexgpt-lite/latest
